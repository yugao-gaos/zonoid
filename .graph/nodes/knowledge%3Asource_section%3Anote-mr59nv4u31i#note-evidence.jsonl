{"evt":"knowledge_node_upserted","id":"knowledge:source_section:note-mr59nv4u31i#note-evidence","key":"knowledge:source_section:note-mr59nv4u31i#note-evidence","workspace":"/Users/imyu/Desktop/zonoid","type":"source_section","kind":"source_section","label":"game ls20 world model program chunk 1 of 3 evidence","title":"game ls20 world model program chunk 1 of 3 evidence","summary":"chunk 1 of 3\n# World-model program for an ARC-AGI-3 game.\n# Scope of this revision: player_movement.\n#   The player is a rigid linked unit = the (unique) color-12 object plus the\n#   color-9 object physically linked to it. Each action translates the whole\n#   unit by a fixed vector:\n#       ACTION1 -> (dr=-5, dc= 0)   (up)      -- dominant move\n#       ACTION2 -> (dr=+5, dc= 0)   (down)\n#       ACTION3 -> (dr= 0, dc=-5)   (left)\n#       ACTION4 -> (dr= 0, dc=+5)   (right)\n# Every other per-step effect on the board (maze scroll, box clipping, HUD bars)\n# is a separate mechanic not modeled here; those cells are rendered UNKNOWN so\n# they are skipped by the validator instead of being predicted incorrectly.\n\nimport re\n\n_PLAYER_COLORS = (9, 12)\n\n_VECTORS = {\n    1: (-5, 0),\n    2: (5, 0),\n    3: (0, -5),\n    4: (0, 5),\n}\n\ndef _action_vector(action):\n    \"\"\"Map an action (string like 'ACTION1' or an int) to a (dr, dc) vector.\"\"\"\n    m = re.search(r\"(\\d+)\", str(action))\n    n = int(m.group(1)) if m else 0\n    return _VECTORS.get(n, (0, 0))\n\ndef _find_player_cells(grid, h, w):\n    \"\"\"Flood-fill the {9,12}-connected compon","metadata":{"note_key":"note:note-mr59nv4u31i","origin":"overlay/note"},"source_path":null,"section_ref":"note-evidence","chunk_ref":null,"cluster_ref":null,"created_at":"2026-07-03T18:28:16.384Z","updated_at":"2026-07-03T18:28:16.384Z","vec":[-0.024452228099107742,-0.016081131994724274,0.029405567795038223,-0.04162643477320671,0.09000623971223831,0.060983117669820786,0.06200576201081276,0.0023428364656865597,0.06853821873664856,0.0142