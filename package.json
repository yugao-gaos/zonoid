{
  "name": "@zonoid/core",
  "version": "0.9.0",
  "description": "The agent's subconscious for coding work: execution-coupled memory that routes task history, decisions, costs, and learned skills into the next move.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yugao-gaos/zonoid.git"
  },
  "main": "daemon.js",
  "bin": {
    "zonoid": "./bin/backfill-merged.js",
    "zonoid-install": "./bin/install.js"
  },
  "files": [
    "daemon.js",
    "mcp-graph.js",
    "lib/",
    "bin/",
    "hooks/",
    "adapters/",
    "skills/",
    "public/",
    "scripts/",
    "schemas/",
    "docs/",
    "pricing.json",
    "mcp.sample.json",
    "settings.sample.json",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node daemon.js",
    "test": "node scripts/run-tests.js",
    "test:all": "node scripts/run-tests.js && npm run test:smoke",
    "test:smoke": "bash test/smoke.sh"
  },
  "optionalDependencies": {
    "@xenova/transformers": "2.17.2"
  }
}
