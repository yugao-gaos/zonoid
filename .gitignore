# Secrets — never commit
certs/
token

# Per-machine runtime state (not source)
overlay/
sessions/
worktrees/
workspace
loop.json
loops.json
*.log
op-cache.json
tool-analytics.json

# OS / deps
node_modules/
.DS_Store
agents.json

# Local embedding model weights (downloaded at runtime by lib/embed.js — ~90MB, not source)
models/

# Per-machine Claude Code config (generated by: npx @zonoid/cli init)
/.claude/settings.json
/.claude/launch.json
/.claude/scheduled_tasks.lock
_README.bak
.graph/daemon.port
# Invalidated v1-v7 bench results (oracle contamination — not shipped)
bench/results.jsonl
