# Secrets — never commit
certs/
token
.env
.env.local

# Per-machine runtime state (not source)
overlay/
sessions/
worktrees/
workspace
loop.json
loops.json
*.log
op-cache.json
tool-analytics.json

# OS / deps
node_modules/
.DS_Store
agents.json

# Local embedding model weights (downloaded at runtime by lib/embed.js — ~90MB, not source)
models/

# Per-machine Claude Code config (generated by: npx @zonoid/cli init)
/.claude/settings.json
/.claude/launch.json
/.claude/scheduled_tasks.lock
_README.bak
.graph/daemon.port
# Invalidated v1-v7 bench results (oracle contamination — not shipped)
bench/results.jsonl
bench/results-v2.jsonl
bench/results-v3.jsonl
bench/results-v4.jsonl
bench/results-v5.jsonl
bench/results-v5-haiku.jsonl
bench/results-v7.jsonl
bench/report.json
bench/report-v2.json
bench/report-v3.json
bench/report-v4.json
bench/report-v5.json
bench/report-v5-haiku.json
bench/report-v7.json
bench/run-v2.log
bench/*.log

# runtime artifacts (never commit)
embed.pid
embed.sock
logs/

# Schedule-wakeup pidfiles (ORCH_DATA → ~/.claude/orchestrator, which symlinks to this repo in dev)
wake/

# Agent scratch debris (gate-exempt sandbox; keep tracked spike tools)
scratch/*
!scratch/cursor-hook-capture.sh

# Internal business/strategy docs — co-located but NEVER shipped publicly
business/

# Editor backups
.cursor/*.bak

# File-drop task mint stubs (adopted into .graph on first sight; not source)
tasks/

# Frozen .graph snapshot for the isolated bench daemon (generated, large, reproducible from .graph)
bench/snapshot/
