# Secrets — never commit
certs/
token

# Per-machine runtime state (not source)
overlay/
sessions/
worktrees/
workspace
loop.json
loops.json
*.log
op-cache.json
tool-analytics.json

# OS / deps
node_modules/
.DS_Store
agents.json

