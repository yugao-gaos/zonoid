{
  "_comment": "Cross-platform hook wiring for the orchestrator. RECOMMENDED: run \"node bin/install.js\" (or \"--user\" for ~/.claude/settings.json) — it writes this with the correct absolute install path for your OS. To wire by hand instead, merge this into your settings.json and replace every __INSTALL_DIR__ with your orchestrator path. Every hook is invoked as `node \"...js\"`, so there is no bash/jq/curl dependency — it works on Windows, macOS and Linux. Set \"disableAllHooks\": true to turn off.",
  "_comment_auth": "Optional bearer-token auth: export ORCH_TOKEN=<secret> before the daemon starts. When set, /mcp + write endpoints require it; reads stay open. Leave unset (default) for open localhost behavior.",
  "permissions": {
    "allow": [
      "mcp__orchestrator-graph__start_task",
      "mcp__orchestrator-graph__complete_task",
      "mcp__orchestrator-graph__branch_task",
      "mcp__orchestrator-graph__suggest_links",
      "mcp__orchestrator-graph__add_dependency",
      "mcp__orchestrator-graph__record_decision",
      "mcp__orchestrator-graph__request_guidance"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"__INSTALL_DIR__/hooks/statusline.js\"",
    "refreshInterval": 2
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"__INSTALL_DIR__/hooks/start-daemon.js\"", "timeout": 8 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"__INSTALL_DIR__/hooks/classify.js\"", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"__INSTALL_DIR__/hooks/orch-stop.js\"" }] },
      { "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "node \"__INSTALL_DIR__/hooks/orch-gate.js\"" }] },
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "node \"__INSTALL_DIR__/hooks/orch-gate-bash.js\"" }] }
    ],
    "PostToolUse": [
      { "matcher": "Agent|Task", "hooks": [{ "type": "command", "command": "node \"__INSTALL_DIR__/hooks/post-agent.js\"" }] },
      { "matcher": "TaskCreate", "hooks": [{ "type": "command", "command": "node \"__INSTALL_DIR__/hooks/suggest-links.js\"" }] },
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"__INSTALL_DIR__/hooks/orch-posttool-starttask.js\"" }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "node \"__INSTALL_DIR__/hooks/subagent-start.js\"" }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node \"__INSTALL_DIR__/hooks/subagent-stop.js\"" }] }
    ]
  }
}
