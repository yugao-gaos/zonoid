{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/imyu/.claude/orchestrator/hooks/orch-stop.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/imyu/.claude/orchestrator/hooks/orch-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "TaskCreate",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/imyu/.claude/orchestrator/hooks/suggest-links.sh"
          }
        ]
      },
      {
        "matcher": "mcp__orchestrator-graph__start_task",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/imyu/Desktop/zonoid/hooks/orch-posttool-starttask.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/imyu/.claude/orchestrator/hooks/start-daemon.sh",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/imyu/.claude/orchestrator/hooks/classify.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/imyu/.claude/orchestrator/hooks/subagent-start.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/imyu/.claude/orchestrator/hooks/subagent-stop.sh"
          }
        ]
      }
    ]
  }
}
